[Unit]
Description=Threat host and Docker firewall
Before=docker.service threat-stack.service
After=network-pre.target
Wants=network-pre.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/threat/firewall-apply
ExecReload=/usr/local/libexec/threat/firewall-apply
[Install]
WantedBy=multi-user.target
