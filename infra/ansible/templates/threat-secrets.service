[Unit]
Description=Decrypt SOPS secrets into tmpfs
Before=threat-stack.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/threat/materialize-secrets.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/threat-service
RuntimeDirectory=threat-service
RuntimeDirectoryMode=0700
[Install]
WantedBy=multi-user.target
