table inet threat {
 chain input {
  type filter hook input priority -10; policy drop;
  ct state invalid drop
  iifname "lo" accept
  ct state established,related accept
  ip protocol icmp accept
  meta l4proto ipv6-icmp accept
  udp sport 67 udp dport 68 accept
  ip saddr {{ admin_cidr }} tcp dport 22 ct state new limit rate 10/minute burst 20 packets accept
{% if admin_cidr_v6 | default('') %}
  ip6 saddr {{ admin_cidr_v6 }} tcp dport 22 ct state new limit rate 10/minute burst 20 packets accept
{% endif %}
  iifname "br-th-*" drop
  tcp dport { 80, 443 } accept
 }
 chain forward {
  type filter hook forward priority -10; policy drop;
  ct state invalid drop
  ct state established,related accept
  # Only DNAT via the two published Caddy ports is reachable externally.
  iifname != "br-th-*" ip daddr 172.30.40.2 tcp dport { 8080, 8443 } ct status dnat accept
  ip saddr 172.30.41.2 ip daddr 172.30.41.3 tcp dport 8080 accept
  ip saddr { 172.30.42.3, 172.30.42.4 } ip daddr 172.30.42.2 tcp dport 5432 accept
  # Caddy: ACME, certificate validation. No arbitrary container egress.
  ip saddr 172.30.40.2 tcp dport { 80, 443 } accept
  ip saddr { 172.30.40.3, 172.30.40.4 } ip daddr {{ backup_ip }} tcp dport {{ backup_port }} accept
 }
}
