{
 admin off
 http_port 8080
 https_port 8443
 servers {
  protocols h1 h2
  timeouts {
   read_header 5s
   read_body 10s
   write 20s
   idle 60s
  }
  max_header_size 16KB
 }
}
{$SITE_ADDRESS} {
 {$TLS_DIRECTIVE}
 header {
  -Server
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  X-Frame-Options DENY
 }
 @api path /info /info/* /openapi.json /health/ready
 route {
  rate_limit {
   zone total {
    key service
    events 1000
    window 1s
   }
   zone per_ip {
    key {http.request.remote.host}
    events 120
    window 1m
    ipv6_prefix 64
   }
   zone writes {
    match {
     method POST PUT
    }
    key {http.request.remote.host}
    events 20
    window 1m
    ipv6_prefix 64
   }
  }
  request_body {
   max_size 64KB
  }
  reverse_proxy @api api:8080 {
   header_up -X-Forwarded-For
   header_up -X-Real-IP
   header_up -Forwarded
   transport http {
    dial_timeout 2s
    response_header_timeout 6s
   }
  }
  respond 404
 }
 handle_errors {
  header Content-Type application/json
  respond `{"message":"{err.status_text}"}` {err.status_code}
 }
}

http://127.0.0.1:8090 {
 respond /health/live "ok" 200
}
